# ==========================================
# SMARTPOS Production Environment Variables
# ==========================================

NODE_ENV=production
PORT=5000

# PostgreSQL 17 Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=smartpos
DB_USER=postgres
DB_PASSWORD=YOUR_STRONG_POSTGRES_PASSWORD_HERE

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# JWT Security
JWT_SECRET=GENERATE_64_CHAR_RANDOM_SECRET_KEY_FOR_ACCESS_TOKEN
JWT_REFRESH_SECRET=GENERATE_64_CHAR_RANDOM_SECRET_KEY_FOR_REFRESH_TOKEN
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=https://smartpos.uz,https://admin.smartpos.uz

# Uzbekistan Payment Gateways
CLICK_SERVICE_ID=YOUR_CLICK_SERVICE_ID
CLICK_MERCHANT_ID=YOUR_CLICK_MERCHANT_ID
CLICK_SECRET_KEY=YOUR_CLICK_SECRET_KEY

PAYME_MERCHANT_ID=YOUR_PAYME_MERCHANT_ID
PAYME_KEY=YOUR_PAYME_SECRET_KEY

# Soliq / OFD Fiscalization (Uzbekistan Tax Committee)
SOLIQ_OFD_API_URL=https://ofd.soliq.uz/api/v1
SOLIQ_OFD_API_KEY=YOUR_SOLIQ_API_KEY
SOLIQ_OFD_TIN=YOUR_COMPANY_STIR_INN

# Default Localization
TIMEZONE=Asia/Tashkent
CURRENCY=UZS
DEFAULT_LANGUAGE=uz
