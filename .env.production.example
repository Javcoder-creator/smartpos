# ==============================================================================
# SMARTPOS — Production Environment Variables Configuration
# ==============================================================================
# Ushbu faylni ishlab chiqarish muhitida ishlatish uchun nusxa oling:
# cp .env.production.example .env (yoki Render/Vercel platformalariga kiriting)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Asosiy Server Sozlamalari
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=5000

# ------------------------------------------------------------------------------
# 2. PostgreSQL 17 Ma'lumotlar Bazasi
# ------------------------------------------------------------------------------
# 🅰️ VARIANT A: Bulutli xizmatlar (Neon.tech, Supabase, Render PostgreSQL)
# Agar Neon.tech yoki Supabase ishlatayotgan bo'lsangiz, faqat bitta DATABASE_URL yetarli:
DATABASE_URL=postgresql://username:password@ep-xyz.eu-central-1.aws.neon.tech/smartpos?sslmode=require

# 🅱️ VARIANT B: Docker yoki O'z VPS Serveringizdagi PostgreSQL
# Agar alohida parametrlarda berishni xohlasangiz (Docker Compose holatida):
DB_HOST=postgres
DB_PORT=5432
DB_NAME=smartpos
DB_USER=postgres
DB_PASSWORD=YOUR_STRONG_POSTGRES_PASSWORD_HERE

# ------------------------------------------------------------------------------
# 3. Redis Kesh va Navbatlar (Ixtiyoriy)
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 4. JWT Xavfsizlik Kalitlari (Dual-Token Auth)
# ------------------------------------------------------------------------------
# Har bir kalit kamida 32 yoki 64 belgili murakkab tasodifiy matn bo'lishi shart!
JWT_ACCESS_SECRET=super_secret_jwt_access_token_key_smartpos_2026_production
JWT_REFRESH_SECRET=super_secret_jwt_refresh_token_key_smartpos_2026_production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ------------------------------------------------------------------------------
# 5. CORS Sozlamalari (Veb-Sayt Domeni)
# ------------------------------------------------------------------------------
# Frontend qayerda joylashgan bo'lsa, o'sha domen(lar)ni vergul bilan kiriting.
# Hammasiga ruxsat berish uchun: *
CORS_ORIGIN=https://smartpos-uz.vercel.app,http://localhost:5173

# ------------------------------------------------------------------------------
# 6. O'zbekiston To'lov Tizimlari (Payment Gateways)
# ------------------------------------------------------------------------------
# Click Merchant API
CLICK_SERVICE_ID=YOUR_CLICK_SERVICE_ID
CLICK_MERCHANT_ID=YOUR_CLICK_MERCHANT_ID
CLICK_SECRET_KEY=click_production_secret_key

# Payme Merchant API (JSON-RPC 2.0)
PAYME_MERCHANT_ID=YOUR_PAYME_MERCHANT_ID
PAYME_KEY=payme_production_secret_key

# ------------------------------------------------------------------------------
# 7. Soliq / OFD Fiskalizatsiya (Davlat Soliq Qo'mitasi)
# ------------------------------------------------------------------------------
SOLIQ_OFD_API_URL=https://ofd.soliq.uz/api/v1
SOLIQ_OFD_API_KEY=YOUR_SOLIQ_API_KEY
SOLIQ_OFD_TIN=YOUR_COMPANY_STIR_INN

# ------------------------------------------------------------------------------
# 8. Standart Lokalizatsiya
# ------------------------------------------------------------------------------
TIMEZONE=Asia/Tashkent
CURRENCY=UZS
DEFAULT_LANGUAGE=uz
